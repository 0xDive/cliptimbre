{
  "version": 2,
  "note": "Starter English and Russian review rules. Add terms for your channel in the installed rules file.",
  "rules": [
    {
      "id": "en-strong-profanity",
      "category": "strong_profanity",
      "severity": "review",
      "label": "Strong profanity",
      "patterns": [
        "\\b(?:fuck(?:ing|ed|er[s]?|s)?|motherfuck(?:er[s]?|ing)|bullshit(?:ting)?|goddamn(?:ed)?)\\b"
      ]
    },
    {
      "id": "en-moderate-profanity",
      "category": "moderate_profanity",
      "severity": "review",
      "label": "Profanity",
      "patterns": [
        "\\b(?:shit(?:s|ty|ting|head[s]?)?|asshole[s]?|bitch(?:es|ing)?)\\b"
      ]
    },
    {
      "id": "ru-strong-profanity",
      "category": "strong_profanity",
      "severity": "review",
      "label": "Мат",
      "patterns": [
        "\\b(?:бля(?:ть|дь|ди|дью|дей|дям|дями|дюга)?|сук(?:а|и|у|ой))\\b",
        "\\b(?:пизд(?:ец(?:а|у|ом)?|а|ы|е|у|ой|ою|ить|ишь|ит|ил[аи]?|ят)|пи[зс]дежь)\\b",
        "\\b(?:(?:на|по|до|за)?ху(?:й|я|ю|ем|е|ев)|оху(?:ел[аи]?|ели|еть|енно|енный|енная))\\b",
        "\\b(?:(?:за|на|вы|по|про|от|пере|раз|у|о)?еб(?:ать|ал[аи]?|у|ем|ешь|ет|ут|ан(?:ый|ая|ые|ого|ую|ым|ых|ное)|нуть|нул[аи]?))\\b",
        "\\b(?:долбоеб|долбаеб|хуесос|уебок|уебки)(?:а|у|ом|ы|ов|ам)?\\b"
      ]
    },
    {
      "id": "ru-moderate-profanity",
      "category": "moderate_profanity",
      "severity": "review",
      "label": "Грубая лексика",
      "patterns": [
        "\\b(?:дерьм(?:о|а|ом|е)|мудак(?:а|у|ом|и|ов|ам)?|пош(?:ел|ла|ли)\\s+нахрен)\\b",
        "\\bнахрен\\b"
      ]
    }
  ]
}
